# Copy this to .env.local and fill in real values. .env.local is
# gitignored; dotenv-cli (wired into every npm script) loads it
# automatically for local dev, and no-ops harmlessly in CI/Vercel, where
# these are set as real environment variables instead.

# Supabase's transaction-mode pooler (port 6543) — what the running app
# (Better Auth's and Drizzle's Postgres clients) connects through.
# `prepare: false` is required on this connection; see
# src/lib/server/db/client.ts and docs/research.md §4.3.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hone

# Supabase's direct connection (port 5432) — what `drizzle-kit
# generate`/`migrate` and `npx auth@latest generate` run against. Falls
# back to DATABASE_URL if unset (e.g. local dev against one flat Postgres).
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hone

# Better Auth's session-signing secret and canonical base URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Stretches (sha256) to the AES-256 key that encrypts each user's Todoist
# API token at rest — see ADR-0002 and src/lib/server/token-crypto.ts.
# Rotating it invalidates every stored token (users re-paste in settings).
TOKEN_ENCRYPTION_KEY=
