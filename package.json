{
  "name": "hone",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.local -- vite dev --port 3000",
    "build": "dotenv -e .env.local -- vite build",
    "preview": "dotenv -e .env.local -- vite preview",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e .env.local -- vitest run",
    "auth:generate": "dotenv -e .env.local -- auth generate --output src/lib/server/db/schema/auth.ts -y",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.43.0",
    "nitro": "^3.0.260903-beta",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.33",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "auth": "^1.7.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "29.1.1",
    "typescript": "^6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
